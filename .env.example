# 工单存储。两项都填写时使用 Supabase；本地留空则写入 .repair/tickets.sqlite。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 兼容旧命名：SUPABASE_SERVICE_ROLE_KEY / NEXT_PUBLIC_SUPABASE_URL 也可识别填在以上位置

# AI 排查建议。优先使用 Vercel AI Gateway；未配置网关时直连 DeepSeek；两项都留空时使用内置指南。
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=deepseek/deepseek-v3.2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Vercel 部署时必填，使用高强度密码。用户名固定为 repair。
REPAIR_ACCESS_PASSWORD=
# 额外内部账号，格式 "用户名:密码,用户名2:密码2"（可选，与上面的 repair 账号并存）
REPAIR_ACCOUNTS=
# 设为 open 时完全跳过登录（公开演示用）；留空则按上面的账号做 Basic 认证
REPAIR_ACCESS_MODE=
